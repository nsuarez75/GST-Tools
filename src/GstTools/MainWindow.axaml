<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GstTools.Controls"
        xmlns:l="using:GstTools"
        x:Class="GstTools.MainWindow"
        x:DataType="l:MainWindow"
        Icon="/Assets/gst-tools.png"
        Title="GST Tools"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- ░░ Marca ░░ -->
        <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="/Assets/gst-tools.png" Width="32" Height="32" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GST Tools" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="{l:T 'Lanzador de las aplicaciones para proyectos SICAR@GST'}" Classes="label" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Click="ShowAbout" ToolTip.Tip="{l:T 'Acerca de'}" VerticalAlignment="Center">
                    <c:Icon Kind="info" Width="17" Height="17" />
                </Button>
            </Grid>
        </Border>

        <!-- ░░ Carpeta donde se buscan y último aviso ░░ -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="16,0,16,14">
            <TextBlock x:Name="Notice" Classes="muted" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="ghost" Click="OpenFolder" ToolTip.Tip="{l:T 'Abrir la carpeta'}">
                <c:Icon Kind="folder" Width="17" Height="17" />
            </Button>
        </Grid>

        <!-- ░░ Una tarjeta por aplicación ░░ -->
        <ItemsControl x:Name="AppList" Margin="16,14,16,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="10" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="l:ToolCard">
                    <Border Classes="card">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Image Source="{Binding Icon}" Width="40" Height="40" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" Classes="h2" />
                                    <Border Classes="pill" Classes.accent="{Binding Found}">
                                        <TextBlock Text="{Binding Status}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" />
                                <Border Classes="pill warn" IsVisible="{Binding HasNewer}" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding UpdateNotice}" />
                                </Border>
                            </StackPanel>
                            <!-- Si la aplicación no está en la carpeta, Abrir queda desactivado y se ofrece descargarla;
                                 también se ofrece si hay una versión nueva -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="ghost" Click="Download" IsVisible="{Binding CanDownload}"
                                        ToolTip.Tip="{Binding DownloadText}">
                                    <c:Icon Kind="download" Width="17" Height="17" />
                                </Button>
                                <Button Classes="accent" Click="OpenApp" IsEnabled="{Binding Found}" ToolTip.Tip="{Binding FilePath}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <c:Icon Kind="play" />
                                        <TextBlock Text="{l:T 'Abrir'}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
