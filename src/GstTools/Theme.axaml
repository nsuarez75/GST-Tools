<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GstTools.Controls">

    <!-- Tokens de color: un acento azul, superficies neutras y tres colores de estado -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="App.Background" Color="#F4F6F9" />
                    <SolidColorBrush x:Key="App.Surface" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="App.SurfaceHover" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="App.Border" Color="#E2E6EC" />
                    <SolidColorBrush x:Key="App.Text" Color="#18202B" />
                    <SolidColorBrush x:Key="App.TextMuted" Color="#667085" />
                    <SolidColorBrush x:Key="App.Accent" Color="#2563EB" />
                    <SolidColorBrush x:Key="App.AccentSoft" Color="#E8EFFD" />
                    <SolidColorBrush x:Key="App.AccentText" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="App.Good" Color="#15803D" />
                    <SolidColorBrush x:Key="App.GoodSoft" Color="#DCFCE7" />
                    <SolidColorBrush x:Key="App.Warn" Color="#B45309" />
                    <SolidColorBrush x:Key="App.WarnSoft" Color="#FEF3C7" />
                    <SolidColorBrush x:Key="App.Bad" Color="#DC2626" />
                    <SolidColorBrush x:Key="App.BadSoft" Color="#FEE2E2" />
                    <BoxShadows x:Key="App.Shadow">0 1 2 0 #0F172A14, 0 1 3 0 #0F172A0D</BoxShadows>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="App.Background" Color="#0F1115" />
                    <SolidColorBrush x:Key="App.Surface" Color="#171A20" />
                    <SolidColorBrush x:Key="App.SurfaceAlt" Color="#1D2129" />
                    <SolidColorBrush x:Key="App.SurfaceHover" Color="#232833" />
                    <SolidColorBrush x:Key="App.Border" Color="#2A2F3A" />
                    <SolidColorBrush x:Key="App.Text" Color="#E7EAF0" />
                    <SolidColorBrush x:Key="App.TextMuted" Color="#9099A8" />
                    <SolidColorBrush x:Key="App.Accent" Color="#3B82F6" />
                    <SolidColorBrush x:Key="App.AccentSoft" Color="#1B2A45" />
                    <SolidColorBrush x:Key="App.AccentText" Color="#93B8FB" />
                    <SolidColorBrush x:Key="App.Good" Color="#4ADE80" />
                    <SolidColorBrush x:Key="App.GoodSoft" Color="#163322" />
                    <SolidColorBrush x:Key="App.Warn" Color="#FBBF24" />
                    <SolidColorBrush x:Key="App.WarnSoft" Color="#3A2E12" />
                    <SolidColorBrush x:Key="App.Bad" Color="#F87171" />
                    <SolidColorBrush x:Key="App.BadSoft" Color="#3B1C1F" />
                    <BoxShadows x:Key="App.Shadow">0 1 2 0 #00000040</BoxShadows>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Base -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource App.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, $Default" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Textos -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Rótulo en mayúsculas de una sección o columna -->
    <Style Selector="TextBlock.caption, TextBlock.columnHeader">
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <!-- Tarjetas, barras y separadores -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="BoxShadow" Value="{DynamicResource App.Shadow}" />
    </Style>
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
    </Style>
    <!-- Pastillas (contadores, estado) -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceAlt}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Border.pill.accent">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
    </Style>
    <Style Selector="Border.pill.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
    </Style>
    <!-- Botones: por defecto secundario (fondo de superficie y borde), acento para la acción principal
         y fantasma para los de solo icono -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource App.Bad}" />
    </Style>
    <!-- Deshabilitados: el mismo aspecto, atenuado (no el bloque gris de Fluent) -->
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextMuted}" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button c|Icon">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
